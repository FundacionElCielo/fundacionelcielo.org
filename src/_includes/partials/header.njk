{% from "partials/icons.njk" import icon %}
{% from "macros/button.njk" import button %}

<a href="#main" class="skip-link">Saltar al contenido principal</a>

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a href="/" class="brand" aria-label="{{ site.name }} — inicio">
      <img
        src="/assets/img/logo-icon-teal.png"
        alt=""
        class="brand__mark"
        width="1200"
        height="515"
        loading="eager"
        decoding="async"
      >
      <span class="brand__word">El Cielo<small>CCREIBEC</small></span>
    </a>

    <nav class="nav-desktop" aria-label="Principal">
      <ul class="nav-desktop__list">
        <li>
          <a href="/" class="nav-link"{% if page.url == "/" %} aria-current="page"{% endif %}>
            {{ site.nav.homeLabel }}
          </a>
        </li>
        {%- for item in collections.pages %}
        <li>
          <a href="{{ item.url }}" class="nav-link"{% if page.url == item.url %} aria-current="page"{% endif %}>
            {{ item.data.navLabel }}
          </a>
        </li>
        {%- endfor %}
      </ul>
      <div class="nav-desktop__cta">
        {{ button(site.nav.contactLabel, "/contacto/", "primary", { small: true, showArrow: false }) }}
      </div>
    </nav>

    <button
      type="button"
      class="nav-toggle"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="nav-mobile-panel"
      aria-label="Abrir menú de navegación"
    >
      {{ icon("menu") }}
      {{ icon("close") }}
    </button>
  </div>
</header>

<div class="nav-mobile" id="nav-mobile-panel" data-nav-panel>
  <nav aria-label="Principal (móvil)">
    <ul class="nav-mobile__list">
      <li><a href="/" class="nav-link"{% if page.url == "/" %} aria-current="page"{% endif %}>{{ site.nav.homeLabel }}</a></li>
      {%- for item in collections.pages %}
      <li><a href="{{ item.url }}" class="nav-link"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.data.navLabel }}</a></li>
      {%- endfor %}
    </ul>
  </nav>
  <div class="nav-mobile__footer">
    {{ button(site.nav.contactLabel, "/contacto/", "primary", { block: true }) }}
    <div class="social-row">
      {%- for s in site.social %}
      <a href="{{ s.href }}" aria-label="{{ s.label }}">{{ icon(s.key) }}</a>
      {%- endfor %}
    </div>
  </div>
</div>
